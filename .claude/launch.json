{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nuzm/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3000",
        "-H",
        "127.0.0.1"
      ],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nuzm/admin",
        "exec",
        "next",
        "dev",
        "-p",
        "3001",
        "-H",
        "127.0.0.1"
      ],
      "port": 3001
    },
    {
      "name": "web-worktree",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nuzm/web",
        "exec",
        "next",
        "dev",
        "-p",
        "3100",
        "-H",
        "127.0.0.1"
      ],
      "port": 3100
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3210",
        "--bind",
        "127.0.0.1",
        "--directory",
        "apps/mobile/build/web"
      ],
      "port": 3210
    }
  ]
}
