# Copy to .env for local development. NEVER put real secrets here or in git (docs/02 §10).
PORT=4000
NODE_ENV=development

# Local dev services (scripts/dev-services.sh; project-local, dev-only, trust auth on 127.0.0.1).
# Migrator/admin connection (pnpm db:migrate, db tests):
DATABASE_ADMIN_URL=postgres://nuzm_admin@127.0.0.1:54329/nuzm_dev
NUZM_TEST_ADMIN_URL=postgres://nuzm_admin@127.0.0.1:54329/postgres
# Runtime roles (least privilege). Run `pnpm db:dev-logins` once to give them a dev-only password:
DATABASE_URL=postgres://nuzm_app:nuzm_dev_only@127.0.0.1:54329/nuzm_dev
WORKER_DATABASE_URL=postgres://nuzm_worker:nuzm_dev_only@127.0.0.1:54329/nuzm_dev
REDIS_URL=redis://127.0.0.1:6390

# OIDC (D-04 open: any standards-compliant provider). Values below are placeholders.
OIDC_ISSUER=http://localhost:8080/realms/nuzm
OIDC_CLIENT_ID=nuzm-web
OIDC_CLIENT_SECRET=replace-me-dev-only
OIDC_REDIRECT_URI=http://127.0.0.1:4000/v1/auth/oidc/callback
RETURN_TO_ORIGINS=http://127.0.0.1:3000
DEFAULT_RETURN_TO=/
# 32 random bytes, base64 (e.g. `openssl rand -base64 32`). Seals the login-state cookie.
SESSION_SEAL_KEY=

# Session/MFA policy (proposals, D-30)
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
LOGIN_RATE_PER_MINUTE=20
MFA_LOCK_THRESHOLD=5
MFA_LOCK_SECONDS=900
STEP_UP_MAX_AGE_SECONDS=300

# Audit (M01 S04). DEV stand-ins until the production vault is decided (D-12).
# AUDIT_CHECKPOINT_KEY signs hash-chain checkpoints (api verify + worker job): 32+ random bytes, base64.
AUDIT_CHECKPOINT_KEY=
# AUDIT_HASH_KEY keys the IP/UA hashes stored in audit rows: 32+ random bytes, base64. Required in production.
AUDIT_HASH_KEY=
AUDIT_VERIFY_INTERVAL_SECONDS=300
# METERING_SOURCE_KEYS: producer service keys for POST /v1/internal/metering/events (placeholder until the vault, D-12).
# JSON array of {"source":"node-agent","sha256":"<hex sha256 of the key>","orgIds":["<uuid>"]?}. Empty = ingest endpoint refuses everyone.
METERING_SOURCE_KEYS=
# SPEND_APPROVAL_TTL_HOURS: how long a spend approval request stays open before it expires (default 24).
SPEND_APPROVAL_TTL_HOURS=24
# QUOTE_TTL_MINUTES: validity of an issued quote (default 15).
QUOTE_TTL_MINUTES=15
# Tax (docs/11 §4): rates live in invoicing.tax_rates (seed/config migrations); these are behaviour switches and format rules,
# every format is [VERIFY] with the tax advisor (HG-03-04).
# TAX_ROUNDING: half_up (default) or half_even.
TAX_ROUNDING=half_up
# TAX_VAT_NUMBER_REGEX / TAX_CR_NUMBER_REGEX / TAX_POSTAL_CODE_REGEX / TAX_BUILDING_NUMBER_REGEX: override the default formats.
# TAX_DEFAULT_SCOPE: baseline tax scope of the platform's services (domestic by default; empty = unconfigured, every estimate is flagged) [VERIFY].
TAX_DEFAULT_SCOPE=domestic
# PSP_MOCK_WEBHOOK_SECRET: signing secret of the SANDBOX mock PSP webhook (dev default when unset). The mock adapter is NOT registered when
# NODE_ENV=production, so no payment can be made in production until a real adapter exists (D-10, HG-03-02).
PSP_MOCK_WEBHOOK_SECRET=
# PAYMENT_RETURN_URL_ALLOWLIST: comma separated origins a customer may be sent back to after 3-D Secure (open-redirect protection).
PAYMENT_RETURN_URL_ALLOWLIST=http://127.0.0.1:3000,http://localhost:3000

# Billing scheduler (ADR-017, proposed): renewals, dunning, PSP event and refund sweepers. 0 = disabled (default); minimum 5 seconds.
BILLING_SCHEDULER_INTERVAL_SECONDS=0
# Data-subject requests and exports (M04 S14b, docs/runbooks/dsr-handling.md): SLA sweep + discovery tick; 0 = off (a request still runs once right after it is made)
DSR_SCHEDULER_INTERVAL_SECONDS=0
# Local export archive directory (development only; production has NO export sink until M08/D-07 and answers 422 no_export_sink)
# EXPORT_LOCAL_DIR=.local/exports
# Dunning policy file (default: spec/billing/dunning-policy.yaml, PROPOSED-NOT-APPROVED until finance approves D-23).
# DUNNING_POLICY_PATH=
# Subscriptions: trial length in days for an organization's first subscription (0 = no trial).
SUBSCRIPTION_TRIAL_DAYS=0

# Wallet top-ups (M03 S10a): minimum / maximum per top-up in minor units; VAT on prepaid credit is booked at consumption (only value supported).
WALLET_TOPUP_MIN_MINOR=1000
WALLET_TOPUP_MAX_MINOR=10000000
WALLET_VAT_TIMING=consumption

# E-invoicing (M03 S11, SYNTHETIC profile; nothing is verified against ZATCA). off (default) | sandbox | simulation. production is refused by the code.
ZATCA_MODE=off
# Development-only key vault and WORM archive directories (self-generated test keys; the vault choice is D-12, the in-Kingdom store D-15).
# ZATCA_DEV_VAULT_DIR=.local/zatca-vault
# ZATCA_ARCHIVE_DIR=.local/zatca-archive
# E-invoicing queue (SIMULATED server): attempts before a dead letter, first backoff in seconds (doubles each attempt), and the cutover date from
# which issued invoices and credit notes get an e-invoice automatically (unset = nothing is generated automatically).
# ZATCA_MAX_ATTEMPTS=6
# ZATCA_BACKOFF_SECONDS=60
# ZATCA_GENERATE_FROM=

# Financial reconciliation (finrec): tolerance in basis points for RC-03 (usage vs invoices) and RC-04 (cost vs bills) — D-31 is finance's decision
# (proposal: 0 for RC-01/02/05/06); and the age in days after which an unresolved break raises an alert (docs/11 proposes 5 business days).
FINREC_RC03_TOLERANCE_BPS=0
FINREC_RC04_TOLERANCE_BPS=0
FINREC_SLA_DAYS=7

# Field-level encryption (M04 S13d). Master keys are vault references (32 random bytes, base64). Exactly one key is `current`; old keys stay listed until
# every value sealed with them has been re-sealed (pnpm --filter @nuzm/api run encrypt:backfill). Unset in development: a throwaway key is created
# in the dev secret store. In production an unset or invalid value STOPS field encryption (fail closed; D-12 vault).
# FIELD_ENCRYPTION_KEYS=[{"id":"k1","ref":"vault://<store>/<secret>","current":true}]

# Managed data and email (M08). No provider is selected (D-05..D-09 open): leave these unset in any real environment.
# Local/CI only (never production): registers the in-memory dev-reference adapters (mock-*), which are NOT VERIFIED and never evidence.
# DATA_LOCAL_REFERENCE=true
# Background tick of the data module (operations, scheduled backups, restore-verification drill, usage samplers); 0/unset = off.
# DATA_SCHEDULER_INTERVAL_SECONDS=30
# Proposals (D-34/D-31 open): DATA_BACKUP_RETENTION_DAYS=7 DATA_BACKUP_INTERVAL_HOURS=24 DATA_VERIFY_INTERVAL_DAYS=7 DATA_ROTATION_WINDOW_HOURS=24
# Email guardrail proposals: EMAIL_RATE_PER_MINUTE=120 EMAIL_WARMUP_BASE_PER_DAY=200 EMAIL_MAX_PER_DAY=50000 EMAIL_THROTTLE_BOUNCE_RATE=0.05 EMAIL_THROTTLE_COMPLAINT_RATE=0.001 EMAIL_BODY_RETENTION_DAYS=7

# Customer sign-in with email and password (ADR-008). Proposals; all optional.
# PASSWORD_LOCK_THRESHOLD=5 PASSWORD_LOCK_SECONDS=900   consecutive failures before a 15 minute lock
# PASSWORD_SCRYPT_LOG_N=17                              scrypt cost for NEW hashes (2^17 = 128 MiB); old hashes keep verifying
# EMAIL_VERIFY_TOKEN_HOURS=24 PASSWORD_RESET_TOKEN_MINUTES=60
# Until a mail provider exists (D-08) the dev mailer prints the verification and reset tokens in the API log; production cannot send them.
