    "jose": "^6.2.17",
    "otpauth": "^9.6.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.5.0",
