{
  "name": "@nuzm/desktop",
  "productName": "Nuzm AI",
  "private": true,
  "version": "0.1.0",
  "description": "Nuzm AI desktop app for Windows and macOS (customer console)",
  "author": "Nuzm",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "pnpm run build && electron .",
    "dist:mac": "pnpm run build && electron-builder --mac --publish never",
    "dist:win": "pnpm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
