{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nuzm.p3-evidence/track/benchmark/1",
  "title": "Phase 3 evidence details: benchmark",
  "description": "Track H: benchmark stage qualification (live stage, accepted thresholds)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "track",
    "stage",
    "model",
    "dataset",
    "thresholdsVersion",
    "thresholdsAcceptedBy",
    "reviewers",
    "scoredTasks",
    "thresholdResults",
    "reportFingerprint"
  ],
  "properties": {
    "track": {
      "const": "H"
    },
    "stage": {
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "sha256",
        "tasks"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tasks": {
          "type": "integer",
          "minimum": 83
        }
      }
    },
    "thresholdsVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "thresholdsAcceptedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "scoredTasks": {
      "type": "integer",
      "minimum": 0
    },
    "notRecorded": {
      "type": "integer",
      "minimum": 0
    },
    "thresholdResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_EVALUATED"
            ]
          },
          "actual": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "reportFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requests",
        "tokensIn",
        "tokensOut"
      ],
      "properties": {
        "requests": {
          "type": "integer",
          "minimum": 0
        },
        "tokensIn": {
          "type": "integer",
          "minimum": 0
        },
        "tokensOut": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
