{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nuzm.p3-evidence/track/deploy/1",
  "title": "Phase 3 evidence details: deploy",
  "description": "Track G / T6: real deployment, versioning, rollback by content hash",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "track",
    "target",
    "releases",
    "ssl",
    "rollback",
    "teardown"
  ],
  "properties": {
    "track": {
      "const": "G"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "region"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "releases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "releaseId",
          "contentSha256",
          "urlChecks"
        ],
        "properties": {
          "releaseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "contentSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "urlChecks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "status",
                "bodySha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "status": {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                "bodySha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "ssl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issued",
        "verified"
      ],
      "properties": {
        "issued": {
          "const": true
        },
        "verified": {
          "const": true
        }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fromReleaseId",
        "toReleaseId",
        "servedSha256AfterRollback",
        "equalsTargetReleaseHash",
        "ownApprovalRef"
      ],
      "properties": {
        "fromReleaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "toReleaseId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "servedSha256AfterRollback": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "equalsTargetReleaseHash": {
          "const": true
        },
        "ownApprovalRef": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "teardown": {
      "enum": [
        "done",
        "scheduled"
      ]
    }
  }
}
