# Pinned Android build toolchain (P3-S06). Source of truth for the Dockerfile, the dedicated-user setup and the guard scripts.
# Flutter/Dart come from apps/api/src/modules/mobile/internal/flutter/toolchain.ts (PINNED_TOOLCHAIN); keep these lines identical to it.
FLUTTER_VERSION=3.35.7
DART_VERSION=3.9.2
# JDK: Temurin 17 (what Flutter 3.35 / AGP 8.x expects; observed on the owner's Mac 2026-11-24: Temurin 17.0.20.1 under ~/.jdks, configured with `flutter config --jdk-dir`)
JDK_MAJOR=17
# Android SDK packages. Observed installed on the owner's Mac (flutter doctor -v, 2026-11-24): platform android-36, build-tools 35.0.0 (also 33.0.1, 34.0.0), platforms 28/30/31/33/34/35/36,
# cmdline-tools/latest, platform-tools, emulator 32.1.14. Licences are NOT all accepted there: accepting them is a human action (B-Android).
ANDROID_PLATFORMS="android-35 android-36"
ANDROID_BUILD_TOOLS="35.0.0"
ANDROID_CMDLINE_TOOLS="latest"
# Needed ONLY for the optional emulator check (not for the APK build). Not installed on the owner's Mac.
ANDROID_EMULATOR_IMAGE="system-images;android-35;google_apis;x86_64"
# Gradle is downloaded by the wrapper that `flutter create` writes; in the offline environment the mirror serves distributions.
GRADLE_DISTRIBUTION_MIRROR_ENV=NUZM_GRADLE_DIST_MIRROR
