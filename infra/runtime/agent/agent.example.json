{
  "nodeId": "staging-node-1",
  "endpointId": "staging-endpoint-1",
  "runtimeClass": "gvisor-runsc",
  "launcher": "runsc",
  "listen": { "host": "10.0.0.5", "port": 8443 },
  "metrics": { "host": "127.0.0.1", "port": 9100 },
  "tls": {
    "keyFile": "/etc/nuzm/tls/agent.key",
    "certFile": "/etc/nuzm/tls/agent.pem",
    "caFile": "/etc/nuzm/tls/control-plane-ca.pem",
    "clientFingerprints": ["<sha256 hex of the control plane's client certificate: pinned>"]
  },
  "trustedControlKeys": { "cp-2026-12": "<PEM of the control plane's PUBLIC Ed25519 token-verification key>" },
  "workspaceRoot": "/var/lib/nuzm/workspaces",
  "stateDir": "/var/lib/nuzm/state",
  "auditFile": "/var/log/nuzm/agent-audit.jsonl",
  "images": { "sha256:<tree digest of the rootfs>": "/var/lib/nuzm/images/<digest-prefix>/rootfs" },
  "toolchainDir": "/var/lib/nuzm/toolchain",
  "maxSlots": 4,
  "egress": { "proxyAddr": "10.200.0.1:3128", "allowHosts": ["registry.npmjs.org"] },
  "runsc": { "path": "/usr/local/bin/runsc", "rootDir": "/run/nuzm/runsc", "platform": "systrap" }
}
