{
  "name": "nuzm",
  "private": true,
  "version": "0.0.0",
  "description": "Nuzm all-in-one hybrid cloud & AI platform (monorepo)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm -r --if-present run test:integration",
    "spec:lint": "spectral lint spec/openapi/openapi.yaml --ruleset spec/openapi/.spectral.yaml --fail-severity=warn",
    "spec:drift": "tsx scripts/spec-drift.ts",
    "db:migrate": "pnpm --filter @nuzm/db run migrate",
    "compliance:classification-coverage": "pnpm --filter @nuzm/db exec tsx src/cli.ts classification",
    "compliance:ropa-coverage": "pnpm --filter @nuzm/db exec tsx src/cli.ts ropa-coverage",
    "compliance:residency-hooks": "pnpm --filter @nuzm/db exec tsx src/cli.ts residency-hooks",
    "compliance:sync-controls": "pnpm --filter @nuzm/db exec tsx src/cli.ts sync-controls",
    "compliance:collect-evidence": "pnpm --filter @nuzm/db exec tsx src/cli.ts collect-evidence",
    "compliance:claims-guard": "tsx scripts/compliance-claims-guard.ts",
    "db:test-rls": "pnpm --filter @nuzm/db run check",
    "scan:secrets": "tsx scripts/scan-secrets.ts",
    "zatca:guard": "tsx scripts/zatca-spec-guard.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm spec:lint && pnpm spec:drift && pnpm sdk:check && pnpm scan:secrets && pnpm zatca:guard && pnpm compliance:claims-guard",
    "services:start": "scripts/dev-services.sh start",
    "services:stop": "scripts/dev-services.sh stop",
    "services:status": "scripts/dev-services.sh status",
    "verify:full": "pnpm verify && pnpm services:status && pnpm db:migrate && pnpm db:test-rls && pnpm compliance:classification-coverage && pnpm compliance:ropa-coverage && pnpm compliance:residency-hooks && pnpm test:integration",
    "db:dev-logins": "pnpm --filter @nuzm/db run dev-logins",
    "db:dev-features": "pnpm --filter @nuzm/db exec tsx src/cli.ts dev-enable-features",
    "db:dev-ai-credits": "pnpm --filter @nuzm/api run grant-ai-credits",
    "db:dev-seed-cloud": "pnpm --filter @nuzm/db exec tsx src/cli.ts dev-seed-cloud",
    "db:dev-seed": "pnpm --filter @nuzm/db exec tsx src/cli.ts dev-seed",
    "sdk:generate": "pnpm --filter @nuzm/sdk run generate",
    "sdk:check": "pnpm --filter @nuzm/sdk run check",
    "test:e2e": "pnpm --filter @nuzm/web build && pnpm --filter @nuzm/admin build && pnpm --filter @nuzm/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stoplight/spectral-cli": "^6.17.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
