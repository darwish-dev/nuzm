import { describe, expect, it } from 'vitest';
import { executionGateway } from '../../index';
import { ExecutionBuildPort } from './index';

/**
 * S04's shared hand-off conformance test (`executionGateway.runLifecycleHandoffConformance`, CONTRACT-04-4) run with S05's REAL adapter. PENDING until Session 04's branch is on this
 * tree: rename to `handoff-conformance.spec.ts` (drop `.pending`). `expectSource: true` because the adapter now passes `ctx.source` (H-9 must PASS, not be skipped).
 */
const adapt = (port: never) => new ExecutionBuildPort(port, () => '2026-11-24T00:00:00Z');
describe('lifecycle hand-off conformance with the real ExecutionBuildPort', () => {
  for (const make of [executionGateway.createMockHandoffRig, executionGateway.createSimulatedNodeHandoffRig]) {
    it(`${make.name}: all cases pass, none skipped, H-9 included`, async () => {
      const report = await executionGateway.runLifecycleHandoffConformance(make(adapt as never), { expectSource: true });
      expect(report.fail, JSON.stringify(report.cases.filter((c) => c.status !== 'PASS'))).toBe(0);
      expect(report.skipped).toBe(0);
      expect(report.cases.find((c) => c.id === 'H-9')!.status).toBe('PASS');
    });
  }
});
