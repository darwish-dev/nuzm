// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`component snapshots > contact_form (ar) 1`] = `
"<section id="s-form1" class="sec sec-contact_form bg-muted align-start" aria-labelledby="h-form1">
<div class="wrap">
<h2 id="h-form1">أرسل لنا رسالة</h2>
<p>نرد خلال يوم</p>
<form class="form" method="post" action="/v1/public/forms/contact" data-status="msg-form1" data-success="شكرًا، وصلتنا رسالتك">
<div class="field">
<label for="f-form1-name">الاسم<span class="req" aria-hidden="true">*</span></label>
<input id="f-form1-name" name="name" type="text" autocomplete="name" required>
</div>
<div class="field">
<label for="f-form1-email">البريد<span class="req" aria-hidden="true">*</span></label>
<input id="f-form1-email" name="email" type="email" autocomplete="email" required>
</div>
<div class="field">
<label for="f-form1-phone">الجوال</label>
<input id="f-form1-phone" name="phone" type="tel" autocomplete="tel">
</div>
<div class="field">
<label for="f-form1-message">رسالتك<span class="req" aria-hidden="true">*</span></label>
<textarea id="f-form1-message" name="message" rows="5" required></textarea>
</div>
<div class="hp" aria-hidden="true">
<label for="hp-form1">الموقع الإلكتروني (اتركه فارغًا)</label>
<input id="hp-form1" name="website_url" type="text" tabindex="-1" autocomplete="off">
</div>
<button class="btn" type="submit">إرسال</button>
</form>
<div class="form-status" id="msg-form1" role="status" tabindex="-1"></div>
</div>
</section>
"
`;

exports[`component snapshots > contact_form (en) 1`] = `
"<section id="s-form1" class="sec sec-contact_form bg-muted align-start" aria-labelledby="h-form1">
<div class="wrap">
<h2 id="h-form1">Send us a message</h2>
<p>We reply within a day</p>
<form class="form" method="post" action="/v1/public/forms/contact" data-status="msg-form1" data-success="Thanks, we got your message">
<div class="field">
<label for="f-form1-name">Name<span class="req" aria-hidden="true">*</span></label>
<input id="f-form1-name" name="name" type="text" autocomplete="name" required>
</div>
<div class="field">
<label for="f-form1-email">Email<span class="req" aria-hidden="true">*</span></label>
<input id="f-form1-email" name="email" type="email" autocomplete="email" required>
</div>
<div class="field">
<label for="f-form1-phone">Phone</label>
<input id="f-form1-phone" name="phone" type="tel" autocomplete="tel">
</div>
<div class="field">
<label for="f-form1-message">Message<span class="req" aria-hidden="true">*</span></label>
<textarea id="f-form1-message" name="message" rows="5" required></textarea>
</div>
<div class="hp" aria-hidden="true">
<label for="hp-form1">Website (leave this empty)</label>
<input id="hp-form1" name="website_url" type="text" tabindex="-1" autocomplete="off">
</div>
<button class="btn" type="submit">Send</button>
</form>
<div class="form-status" id="msg-form1" role="status" tabindex="-1"></div>
</div>
</section>
"
`;

