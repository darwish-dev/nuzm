{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "NODE_ENV",
        "ADMIN_ORIGIN",
        "API_ORIGIN",
        "BUILDER_PREVIEW_DOMAIN",
        "BUILDER_PREVIEW_SCHEME"
      ]
    },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/spec/**"] },
    "dev": { "cache": false, "persistent": true }
  }
}
